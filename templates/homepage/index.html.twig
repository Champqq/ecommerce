{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container mt-5" style="min-height: calc(100vh - 200px);">
            <h2 class="mb-4">Filters</h2>
            <form action="{{ path('homepage') }}" method="get">
                <div class="row mb-3">
                    <div class="col">
                        <label for="min_price">Min Price</label>
                        <input type="number" class="form-control" id="min_price" name="min_price" value="{{ app.request.query.get('min_price') }}" placeholder="Min Price">
                    </div>
                    <div class="col">
                        <label for="max_price">Max Price</label>
                        <input type="number" class="form-control" id="max_price" name="max_price" value="{{ app.request.query.get('max_price') }}" placeholder="Max Price">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label for="category">Category</label>
                        <select name="category" id="category" class="form-control">
                            <option value="">Select Category</option>
                            <option value="Shoes" {% if app.request.query.get('category') == 'Shoes' %}selected{% endif %}>Shoes</option>
                            <option value="Shirts" {% if app.request.query.get('category') == 'Shirts' %}selected{% endif %}>Shirts</option>
                            <option value="Pants" {% if app.request.query.get('category') == 'Pants' %}selected{% endif %}>Pants</option>
                        </select>
                    </div>

                    <div class="col">
                        <label for="size">Size</label>
                        <select name="size" id="size" class="form-control">
                            <option value="">Select Size</option>
                                <option value="36" {% if app.request.query.get('size') == '36' %}selected{% endif %}>36</option>
                                <option value="37" {% if app.request.query.get('size') == '37' %}selected{% endif %}>37</option>
                                <option value="38" {% if app.request.query.get('size') == '38' %}selected{% endif %}>38</option>
                                <option value="39" {% if app.request.query.get('size') == '39' %}selected{% endif %}>39</option>
                                <option value="40" {% if app.request.query.get('size') == '40' %}selected{% endif %}>40</option>
                                <option value="XS" {% if app.request.query.get('size') == 'XS' %}selected{% endif %}>XS</option>
                                <option value="S" {% if app.request.query.get('size') == 'S' %}selected{% endif %}>S</option>
                                <option value="M" {% if app.request.query.get('size') == 'M' %}selected{% endif %}>M</option>
                                <option value="L" {% if app.request.query.get('size') == 'L' %}selected{% endif %}>L</option>
                                <option value="XL" {% if app.request.query.get('size') == 'XL' %}selected{% endif %}>XL</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Apply Filters</button>
                    <a href="{{ path('homepage') }}" class="btn btn-secondary">Reset Filters</a>
                </div>
            </form>

            <h2 class="mt-5 mb-4">Products</h2>
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-4 justify-content-center">
                {% if products is not empty %}
                    {% for product in products %}
                        {% include 'components/product-card.html.twig' with {'product': product} %}
                    {% endfor %}
                {% else %}
                    <p>No products found for the selected filters.</p>
                {% endif %}
            </div>

            <h2 class="mt-5 mb-4">New</h2>
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-4 justify-content-center">
                {% for product in latest %}
                    {% include 'components/product-card.html.twig' with {'product': product} %}
                {% endfor %}
            </div>

            <h2 class="mt-5 mb-4">Popular</h2>
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-4 justify-content-center">
                {% for product in popular %}
                    {% include 'components/product-card.html.twig' with {'product': product} %}
                {% endfor %}
            </div>

        </div>
    </section>
{% endblock %}
