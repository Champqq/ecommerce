{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1>Management</h1>
                <p>On the "users" page you can delete a user or change their role.</p>

                <p>On the "products" page you can view the product in detail, edit or delete it, and create a new one.</p>

                <p>On the "categories" page you can edit or delete an existing category, and create a new one.</p>

                <p>On the "orders" page you can view the order in detail, change their status, and delete it.</p>
            </div>
        </div>
    </div>
{% endblock %}
