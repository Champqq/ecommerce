{% extends 'base.html.twig' %}

{% block title %}Order history{% endblock %}

{% block body %}
    <div class="container mt-5" style="min-height: calc(100vh - 200px);">
        <h1 class="mb-4 text-center">Order history</h1>

        {% if orders is not empty %}
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center">
                    <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Details</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for order in orders %}
                        <tr>
                            <td>{{ order.number }}</td>
                            <td>{{ order.createdAt ? order.createdAt|date('Y-m-d H:i') : '—' }}</td>
                            <td>
                                <span class="badge bg-info text-dark">{{ order.status|capitalize }}</span>
                            </td>
                            <td>{{ order.totalMoney|money }} $</td>
                            <td>
                                <a href="{{ path('order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-info text-center" role="alert">
                You haven't placed any orders yet.
            </div>
        {% endif %}

        <div class="text-center mt-4">
            <a href="{{ path('profile') }}" class="btn btn-outline-dark">Back to profile</a>
        </div>
    </div>
{% endblock %}
